rules_version = '2';

/*  Access model
    ------------
    A board document carries `ownerEmail` and `allowedEmails`. Only signed-in
    Google accounts listed in `allowedEmails` can read or write that board and
    its cards. Everyone else is refused by the database, so a leaked URL is not
    a leaked board.

    Paste this whole file into:
      Firebase console -> Firestore Database -> Rules -> Publish
*/
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/boards/$(boardId);
    }

    function boardExists(boardId) {
      return exists(boardPath(boardId));
    }

    /*  STANDING TEAM ALLOW LIST.
        ------------------------
        Everyone except the owner. These addresses can open and edit the
        board by signing in, without being added through the People dialog
        first. The owner is covered by ownerEmails and does not belong here.

        Gmail ignores dots and +tags, so one mailbox has several spellings
        and Firebase reports whichever the account was registered with. The
        generator expands each address into every form it can arrive as.

        Real addresses are never committed — this repository is public.
        Generate the file to publish with:
            ./owner-rules.sh owner@example.com member@example.com ...

        The placeholder matches nobody, so an unedited file grants nothing. */
    function teamEmails() {
      return ["PUT_TEAM_EMAILS_HERE"];
    }

    function isTeam() {
      return signedIn() && myEmail() in teamEmails();
    }

    /*  Three ways in, any one sufficient:
          the owner, who is never not a member of their own board;
          the standing team list, which works before anyone invites you;
          the board's own allowedEmails, which the owner edits in the People
          dialog without visiting the console.

        The owner is covered here rather than being repeated in teamEmails, so
        each list means exactly one thing and no address appears twice.     */
    function isMember(boardId) {
      return isFounder()
             || isTeam()
             || (signedIn()
                 && boardExists(boardId)
                 && myEmail() in get(boardPath(boardId)).data.allowedEmails);
    }

    function isOwner(boardId) {
      return signedIn()
             && boardExists(boardId)
             && get(boardPath(boardId)).data.ownerEmail == myEmail();
    }

    /*  WHO MAY CREATE THE BOARD IN THE FIRST PLACE.
        --------------------------------------------
        The owner, lower case, plus any equivalent spellings of the same
        mailbox. Change it only before the board exists; afterwards ownership
        lives in the document itself.

        Without this pin, "signed in" means any Google account in the world,
        and whoever reaches an unclaimed board first becomes its permanent
        owner — recoverable only by deleting the document by hand.         */
    function ownerEmails() {
      return ["PUT_THE_OWNER_EMAIL_HERE"];
    }

    function isFounder() {
      return signedIn() && myEmail() in ownerEmails();
    }

    match /boards/{boardId} {

      /*  A board that does not exist yet must be readable by a signed-in
          user, otherwise the app cannot tell "not created" apart from
          "not allowed" and can never bootstrap itself. Reading a missing
          document discloses nothing beyond whether the id is in use.     */
      allow get: if isMember(boardId)
                 || (signedIn() && !boardExists(boardId));

      // Nobody enumerates the boards collection.
      allow list: if false;

      allow create: if isFounder()
                    && request.resource.data.ownerEmail == myEmail()
                    && myEmail() in request.resource.data.allowedEmails;

      /*  Members may rename the board and manage the assignee list.
          Reserved to the owner: who has access, and the column structure.
          The board can never be handed to someone else.

          Columns are compared whole rather than checking "did anything get
          removed", because rules cannot pull the ids out of a list of maps,
          so a delete-plus-add in one write would slip past a length check.
          Owner-only for every column change is the guarantee that actually
          holds — at the cost of members not renaming columns either.      */
      allow update: if isMember(boardId)
                    && request.resource.data.ownerEmail == resource.data.ownerEmail
                    && (request.resource.data.allowedEmails == resource.data.allowedEmails
                        || isOwner(boardId))
                    && (request.resource.data.columns == resource.data.columns
                        || isOwner(boardId));

      allow delete: if isOwner(boardId);

      match /cards/{cardId} {
        allow read, create, update, delete: if isMember(boardId);
      }

      /*  Finished tasks live here instead of in /cards, so the board's live
          listener never pays to download years of history.                */
      match /archive/{cardId} {
        allow read, create, update, delete: if isMember(boardId);
      }

      // Append-only history: members add entries, nobody rewrites them.
      match /activity/{entryId} {
        allow read, create: if isMember(boardId);
        allow update, delete: if false;
      }
    }
  }
}
